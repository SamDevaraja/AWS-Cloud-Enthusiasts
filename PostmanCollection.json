{
  "info": {
    "name": "Cloud Enthusiasts Registration & Attendance System",
    "description": "API collection for testing and integrating with the Cloud Enthusiasts backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"CloudEnthusiasts2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"CloudEnthusiasts2026!\",\n  \"newPassword\": \"NewSecurePassword2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get Live Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events/live?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "events", "live"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Event Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events/:eventId",
              "host": ["{{base_url}}"],
              "path": ["api", "events", ":eventId"],
              "variable": [{ "key": "eventId", "value": "" }]
            }
          }
        },
        {
